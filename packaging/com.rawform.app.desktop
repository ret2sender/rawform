[Desktop Entry]
Type=Application
Name=rawform
GenericName=Audio Player
Comment=Fast, keyboard-friendly audio player
Exec=rawform %F
Icon=com.rawform.app
Terminal=false
Categories=AudioVideo;Audio;Player;Qt;
MimeType=audio/flac;audio/mpeg;audio/mp4;audio/x-mpegurl;audio/ogg;audio/x-vorbis+ogg;audio/x-flac+ogg;audio/x-opus+ogg;audio/x-speex+ogg;audio/x-speex;audio/vnd.wave;audio/x-wav;audio/aac;audio/x-wavpack;audio/x-ape;audio/x-ms-wma;audio/x-aiff;audio/x-musepack;audio/x-tta;audio/ac3;audio/vnd.dts;
Keywords=music;audio;player;playlist;flac;mp3;
StartupNotify=true
SingleMainWindow=true
