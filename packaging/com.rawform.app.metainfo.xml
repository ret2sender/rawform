<component type="desktop-application">
  <id>com.rawform.app</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>rawform</name>
  <summary>Fast, keyboard-friendly audio player</summary>
  <description>
    <p>
      rawform is a foobar2000-inspired desktop audio player. Native reference
      decoders (libsndfile, libFLAC, libmpg123) come first, with FFmpeg as the
      long-tail fallback; audio flows as interleaved 32-bit float, and the
      output device is switched to the source sample rate by default for
      bit-perfect playback, with the published outcome always reporting what
      the hardware is actually doing.
    </p>
    <p>
      Features include gapless playback, tabbed playlists with per-tab
      persistence, tag editing via TagLib, ReplayGain scanning and playback
      with clip prevention, a spectrum display, output device selection, and
      honest bit-perfect reporting down to the driver's realized format on
      PipeWire.
    </p>
  </description>
  <launchable type="desktop-id">com.rawform.app.desktop</launchable>
  <url type="homepage">https://github.com/ret2sender/rawform</url>
  <url type="bugtracker">https://github.com/ret2sender/rawform/issues</url>
  <developer id="io.github.ret2sender">
    <name>Etienne Fleurant</name>
  </developer>
  <categories>
    <category>AudioVideo</category>
    <category>Audio</category>
    <category>Player</category>
  </categories>
  <content_rating type="oars-1.1"/>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <!--
