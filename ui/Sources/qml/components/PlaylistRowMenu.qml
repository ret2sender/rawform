// PlaylistRowMenu.qml
//
// The playlist rows' right-click context menu, themed (blurred translucent)
// to match the menu bar and header menus. The host (PlaylistView) creates it
// on the first right-click and keeps it; it holds no reference to the view,
// the model or the dialogs: the one state it reads comes DOWN through
// `isQueueView`, and every entry raises a request signal the host acts on.
//
// The queue verbs lead: the most frequent action on a row. In a playlist:
// append the selection, or put it next in line. In the queue view those two
// collapse and "Remove from Playback Queue" takes their place (the Delete
// key's twin). The keys are OWNED elsewhere (Q / Shift+Q by the Playback
// menu's items, Delete and Alt+Enter by the table's key handler), so every
// hint here is shortcutHint: drawn in the menu's hint column, never
// registered, or Q would fire twice.

pragma ComponentBehavior: Bound

import QtQuick
import QtQuick.Controls.Basic

ThemedMenu {
    id: rowMenu

    // True while the host shows the Playback Queue; swaps the queue verbs.
    property bool isQueueView: false

    /// Add the selection to the playback queue; `next` puts it at the head.
    signal enqueueRequested(bool next)
    /// Remove the selected queue rows (the queue view's Delete twin).
    signal removeFromQueueRequested()
    /// Force-reload the selection's tags from disk.
    signal reloadRequested()
    /// Drop every missing or unreadable row from the playlist.
    signal removeMissingRequested()
    /// Open the Rename Files dialog on the selection.
    signal renameRequested()
    /// Open the Properties window on the selection.
    signal propertiesRequested()

    ThemedMenuItem {
        text: "Add to Playback Queue"
        shortcutHint: "Q"
        collapsed: rowMenu.isQueueView
        onTriggered: rowMenu.enqueueRequested(false)
    }
    ThemedMenuItem {
        text: "Play Next"
        shortcutHint: "Shift+Q"
        collapsed: rowMenu.isQueueView
        onTriggered: rowMenu.enqueueRequested(true)
    }
    ThemedMenuItem {
        text: "Remove from Playback Queue"
        shortcutHint: "Del"
        collapsed: !rowMenu.isQueueView
        onTriggered: rowMenu.removeFromQueueRequested()
    }
    MenuSeparator {}
    ThemedMenuItem {
        // Right-click already selected the row, so this force-reloads the
        // current selection's tags from disk (mtime/size be damned).
        text: "Reload info from file(s)"
        onTriggered: rowMenu.reloadRequested()
    }
    ThemedMenuItem {
        // Whole-playlist cleanup: drop every grayed (missing/unreadable) row.
        text: "Remove missing tracks"
        onTriggered: rowMenu.removeMissingRequested()
    }
    MenuSeparator {}
    // A submenu, not a flat item, so sibling file operations have a home.
    // The submenu's TITLE item is generated by the parent menu's delegate;
    // ThemedMenuItem there keeps it themed and (via fitWidth) inside the
    // fit-to-content width machinery, per the Qt-Menu-sizing lessons.
    delegate: ThemedMenuItem {}
    ThemedMenu {
        title: "File Operations"
        ThemedMenuItem {
            text: "Rename to…"
            onTriggered: rowMenu.renameRequested()
        }
    }
    MenuSeparator {}
    ThemedMenuItem {
        text: "Properties"
        // "Return" is the main Enter key in Qt's naming (and the glyph
        // macOS shows for it); "Enter" alone would be the keypad key.
        shortcutHint: "Alt+Return"
        onTriggered: rowMenu.propertiesRequested()
    }
}
